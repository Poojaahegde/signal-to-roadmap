# Signal to Roadmap — Environment Configuration
# Copy this file to .env and fill in your values
# Demo mode works without an API key (uses cached responses)

# ── Required for live AI features ───────────────────────────────────────────
# Get your key at https://platform.openai.com/api-keys
OPENAI_API_KEY=sk-your-openai-api-key-here

# ── Database ─────────────────────────────────────────────────────────────────
# SQLite (default for demo):
DATABASE_PATH=./signal_to_roadmap.db

# PostgreSQL (for production):
# DATABASE_URL=postgresql+asyncpg://user:password@localhost:5432/signal_to_roadmap

# ── Backend server ────────────────────────────────────────────────────────────
BACKEND_PORT=8000
BACKEND_HOST=0.0.0.0

# ── Frontend ──────────────────────────────────────────────────────────────────
NEXT_PUBLIC_API_URL=http://localhost:8000

# ── Demo mode ────────────────────────────────────────────────────────────────
# Set to "true" to use pre-cached AI responses (no OpenAI API calls made)
DEMO_MODE=false
